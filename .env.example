# ==========================================
# Taiwan Weather Forecast - Environment Configuration
# ==========================================

# 中央氣象署 (CWA) 開放資料平台 API 金鑰
# 申請網址: https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=

# 預報資料集 ID
# F-C0032-001: 一般天氣預報-今明36小時天氣預報
# F-D0047-089: 臺灣各縣市未來1週天氣預報
# F-D0047-091: 臺灣各縣市鄉鎮未來1週天氣預報
CWA_DATASET_ID=F-C0032-001

# SQLite 資料庫儲存路徑
DATABASE_PATH=data/weather.db
